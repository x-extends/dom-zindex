{
  "name": "dom-zindex",
  "version": "1.0.8",
  "description": "Web common z-index style management",
  "files": [
    "dist",
    "es",
    "types"
  ],
  "scripts": {
    "update": "npm install --legacy-peer-deps",
    "lint:es": "eslint src/** types/**",
    "lint:ox": "oxfmt --check src/** types/**",
    "esfix": "eslint --fix src/** types/**",
    "oxfix": "oxfmt src/** types/** --write",
    "lib": "gulp build"
  },
  "main": "dist/index.common.js",
  "module": "es/index.esm.js",
  "unpkg": "dist/index.umd.js",
  "jsdelivr": "dist/index.umd.js",
  "typings": "types/index.d.ts",
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "~24.12.3",
    "@babel/core": "~7.28.6",
    "@babel/preset-env": "~7.28.6",
    "@babel/runtime": "~7.28.6",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "del": "^6.0.0",
    "eslint": "^10.8.1",
    "eslint-config-flat": "^1.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "gulp": "^4.0.2",
    "gulp-babel": "^8.0.0",
    "gulp-concat": "^2.6.1",
    "gulp-rename": "^2.0.0",
    "gulp-replace": "^1.1.3",
    "gulp-typescript": "^5.0.1",
    "gulp-uglify": "^3.0.2",
    "oxfmt": "~0.51.0",
    "vue-eslint-parser": "^10.4.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "allowScripts": {
    "es5-ext@0.10.64": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x-extends/dom-zindex.git"
  },
  "keywords": [
    "z-index",
    "zindex"
